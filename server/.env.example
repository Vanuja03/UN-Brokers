NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/un-brokers
CLIENT_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-string-of-32-characters
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# SMTP is optional in local development. Inquiries are saved even when email is not configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
BUSINESS_NOTIFICATION_EMAIL=

COMPANY_NAME=UN Insurance Brokers
COMPANY_TAGLINE=Insurance guidance for the things that matter
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_ADDRESS=
COMPANY_OFFICE_HOURS=
DEFAULT_CURRENCY=LKR
BUSINESS_TIMEZONE=Asia/Colombo
ADMIN_APP_URL=http://localhost:5173

# WhatsApp Cloud API. Leave blank to skip the office alert. The token belongs only in this file.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=
WHATSAPP_TEMPLATE=new_quotation
